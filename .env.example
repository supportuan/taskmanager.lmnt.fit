# TaskFlow frontend — copy to .env.local and adjust

# Spring Boot API origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Optional override for auth endpoints (defaults to VITE_API_BASE_URL + /api/auth)
# VITE_AUTH_API_URL=http://localhost:8080/api/auth

# Set to true only for offline dev without the Java backend (default: false)
# VITE_USE_LOCAL_AUTH=true
